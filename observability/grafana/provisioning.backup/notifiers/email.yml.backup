notifiers:
  - name: Email Security Team
    type: email
    uid: email-security
    org_id: 1
    is_default: true
    send_reminder: true
    frequency: 24h
    disable_resolve_message: false
    settings:
      addresses: "abdaty11@gmail.com"
      autoResolve: true
      httpMethod: POST
      severity: critical
      uploadImage: true
    secure_settings: {}

  - name: Email Ops Team
    type: email
    uid: email-ops
    org_id: 1
    is_default: false
    send_reminder: true
    frequency: 12h
    disable_resolve_message: false
    settings:
      addresses: "abdaty11@gmail.com"
      autoResolve: true
      httpMethod: POST
      severity: warning
      uploadImage: false
    secure_settings: {}
