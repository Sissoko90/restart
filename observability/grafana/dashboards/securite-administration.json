    {
      "type": "timeseries",
      "title": "Issues du second facteur",
      "description": "« code FAUX » qui monte est CRITIQUE : pour en arriver la, l'appelant a deja franchi le mot de passe. Six chiffres font un million de possibilites, epuisables en quelques heures sans comptage des echecs.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(rate(auth_second_facteur_total{resultat=\"valide\"}[5m])) * 60",
          "legendFormat": "valide",
          "refId": "A"
        },
        {
          "expr": "sum(rate(auth_second_facteur_total{resultat=\"code_faux\"}[5m])) * 60",
          "legendFormat": "code FAUX",
          "refId": "B"
        },
        {
          "expr": "sum(rate(auth_second_facteur_total{resultat=\"code_absent\"}[5m])) * 60",
          "legendFormat": "code absent",
          "refId": "C"
        },
        {
          "expr": "sum(rate(auth_second_facteur_total{resultat=\"non_enrole\"}[5m])) * 60",
          "legendFormat": "non enrole",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Revocations de jeton par portee",
      "description": "Metrique qui etait DEFINIE et jamais incrementee : aucune serie n'existait, et rien ne distinguait cette absence d'une absence de revocation.",
