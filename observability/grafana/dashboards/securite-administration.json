    {
      "type": "row",
      "title": "Ce qui est bloque",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Verrouillages et tentatives bloquees",
      "description": "Les deux courbes se lisent ENSEMBLE. Verrouillages qui montent = attaque par force brute. Refus qui montent SANS nouveau verrouillage = utilisateur legitime enferme. Une seule des deux ne permet pas de trancher.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(auth_account_lockout_total[5m])) * 60",
          "legendFormat": "verrouillages / min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(auth_tentative_bloquee_total[5m])) * 60",
          "legendFormat": "tentatives refusees / min",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connexions : reussies contre echouees",
      "description": "auth_login_failure_total est la metrique REELLE. L'alerte d'origine interrogeait authentication_failures_total, que rien n'emet.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(auth_login_success_total[5m])) * 60",
          "legendFormat": "reussies / min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(auth_login_failure_total[5m])) * 60",
          "legendFormat": "echouees / min",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
