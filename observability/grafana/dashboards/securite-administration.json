  "timezone": "",
  "title": "Securite et surfaces d'administration",
  "uid": "securite-administration",
  "version": 1,
  "description": "Surveillance des surfaces sensibles : connexion administrateur, second facteur, endpoints /admin, refus du Gateway. Chaque panneau porte en description la source de sa metrique. Toutes sont verifiees presentes par MetriquesDesAlertesTest.",
  "panels": [
    {
      "type": "row",
      "title": "Evenements critiques — une seule occurrence compte",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Second facteur RETIRE (24 h)",
      "description": "Un super administrateur a desactive le second facteur d'un autre administrateur. Legitime uniquement sur appareil perdu. Une seule occurrence suffit a ouvrir un compte d'administration.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(auth_second_facteur_operation_total{operation=\"retrait\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Second facteur remplace (24 h)",
      "description": "Exige le mot de passe ET le code de l'appareil courant. Moins grave qu'un retrait, mais l'ancien appareil cesse immediatement de fonctionner.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(auth_second_facteur_operation_total{operation=\"reinitialisation\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
