    {
      "type": "timeseries",
      "title": "Duree des requetes base (p50 / p95)",
      "description": "Il n'existait AUCUNE mesure de duree de requete dans auth-service. Sans elle, toute decision de cache est une opinion : le pool a 1 connexion allouee sur 50 ne prouve que l'absence de trafic. A comparer aux 241 ms de BCrypt par connexion, qui dominent la latence du chemin d'authentification.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(r2dbc_query_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50 (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(r2dbc_query_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requetes par minute et occupation du pool",
      "description": "Le volume de requetes et les connexions reellement acquises. C'est ce couple qui dit si la base est sollicitee — pas une intuition.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum(rate(r2dbc_query_seconds_count[5m])) * 60",
          "legendFormat": "requetes / min",
          "refId": "A"
        },
        {
          "expr": "max(r2dbc_pool_acquired_connections)",
          "legendFormat": "connexions acquises",
          "refId": "B"
        },
