      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Appels refuses par un disjoncteur ouvert",
      "description": "Ce que le disjoncteur economise : sans lui, chacun de ces appels aurait attendu le delai maximal entier avant d'echouer, pour un resultat connu d'avance.",
      "datasource": "Prometheus",
      "gridPos": {
