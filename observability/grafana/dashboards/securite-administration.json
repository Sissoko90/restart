    {
      "type": "stat",
      "title": "Connexions admin sans second facteur (24 h)",
      "description": "Comptes d'administration proteges par un mot de passe SEUL. Ce n'est pas une attaque : c'est une dette. Enroler via /auth/admin/totp/enroll.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
