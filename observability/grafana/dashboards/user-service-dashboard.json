{
  "dashboard": {
    "title": "User Service - Métriques Métier",
    "tags": [
      "user-service",
      "microservices",
      "business-metrics"
    ],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Utilisateurs Créés (Total)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "user_service_users_created_total",
            "legendFormat": "Total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Utilisateurs Actifs",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "user_service_users_active_count",
            "legendFormat": "Actifs",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 10000,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5000
                },
                {
                  "color": "red",
                  "value": 8000
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Utilisateurs Bloqués/Suspendus",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "user_service_users_blocked_count",
            "legendFormat": "Bloqués",
            "refId": "A"
          },
          {
            "expr": "user_service_users_suspended_count",
            "legendFormat": "Suspendus",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Taux de Création Utilisateurs (req/min)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(user_service_users_created_total[5m]) * 60",
            "legendFormat": "Créations/min",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Créations/min"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 5,
        "title": "Latence Création Utilisateur (p95, p99)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(user_service_users_creation_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, rate(user_service_users_creation_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latence"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 6,
        "title": "Événements Kafka (Succès vs Échecs)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "rate(user_service_kafka_events_processed_total[5m]) * 60",
            "legendFormat": "Succès/min",
            "refId": "A"
          },
          {
            "expr": "rate(user_service_kafka_events_failed_total[5m]) * 60",
            "legendFormat": "Échecs/min",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Événements/min"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 7,
        "title": "Cache Redis (Hit Rate %)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "100 * rate(user_service_cache_hits_total[5m]) / (rate(user_service_cache_hits_total[5m]) + rate(user_service_cache_misses_total[5m]))",
            "legendFormat": "Hit Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "min": 0,
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "green",
                  "value": 80
                }
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Décisions d'administration (24h)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "sum by (decision) (increase(user_service_users_admin_decisions_total[24h]))",
            "legendFormat": "{{decision}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 50
                }
              ]
            }
          }
        }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 36,
    "style": "dark",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ]
    },
    "version": 1
  }
}
