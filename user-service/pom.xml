<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.abdatytch</groupId>
		<artifactId>restart-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<groupId>com.abdatytch</groupId>
	<artifactId>user-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>user-service</name>
	<description>Application micro service</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<!--
			`lombok.version` a ete RETIRE d'ici.

			Il valait 1.18.32 et surchargeait la version geree par le parent
			Spring Boot (1.18.46). Mesure apres consolidation des POM :
			auth-service, gateway-service et media-service resolvaient 1.18.46,
			ce seul module 1.18.32.

			Lombok est un PROCESSEUR D'ANNOTATIONS : une version differente ici
			signifie que ce module genere son code — constructeurs, accesseurs,
			equals — avec un autre compilateur d'annotations que ses voisins. Un
			ecart de comportement n'apparaitrait ni a la compilation ni dans un
			diff, seulement dans le bytecode produit.
		-->
	</properties>
	<dependencies>
		<!-- Détection des appels bloquants sur threads non bloquants (tests) -->
		<dependency>
			<groupId>io.projectreactor.tools</groupId>
			<artifactId>blockhound</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Socle sécurité partagé : JWKS, HMAC Gateway, comparaison de secrets -->
		<dependency>
			<groupId>com.abdatytch</groupId>
			<artifactId>platform-commons</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- R2DBC pour accès base de données réactif non-bloquant -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-r2dbc</artifactId>
		</dependency>
		<!-- Kafka Reactive pour messaging non-bloquant -->
		<dependency>
			<groupId>io.projectreactor.kafka</groupId>
			<artifactId>reactor-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- WebFlux avec Netty pour serveur HTTP réactif non-bloquant -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-consul-discovery</artifactId>
		</dependency>
		<!--
			Equilibrage de charge pour les appels de service a service.

			Il arrivait deja transitivement par consul-discovery, mais ce module
			l'utilise desormais DIRECTEMENT : @LoadBalanced dans WebClientConfig
			et ClientIdentiteAuth. Une dependance dont on depend directement ne
			doit pas reposer sur le graphe d'un autre starter, qui peut cesser de
			la porter a la prochaine montee de version.

			Remplace spring-cloud-starter-openfeign : plus aucune classe du
			module ne reference feign.* depuis que ClientIdentiteAuth porte
			l'appel a auth-service sur WebClient.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>

		<!-- PostgreSQL R2DBC driver pour accès réactif -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>r2dbc-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- PostgreSQL JDBC pour Flyway migrations -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

			<!-- JWT Dependencies -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.5</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Dotenv for environment variables -->
		<dependency>
			<groupId>io.github.cdimascio</groupId>
			<artifactId>dotenv-java</artifactId>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		
		<!-- Micrometer Tracing -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-brave</artifactId>
		</dependency>

		<!-- Redis Reactive pour caching non-bloquant -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>

		<!-- Resilience4j for circuit breaker, retry, rate limiter -->
		<!--
			resilience4j-spring-boot3 a ete RETIRE, et ce n'est pas un choix de
			confort : en 2.4.0 il REFUSE de demarrer sur Spring Boot 4.

			  Module 'io.github.resilience4j:resilience4j-spring-boot3' is only
			  compatible with Spring Boot 3.x

			Mesure : le test de contexte de gateway-service est le seul a
			l'attraper. En 2.1.0 / 2.2.0 ce controle n'existait pas, donc
			l'artefact etait la, silencieux.

			Et il ne servait QU'AUX ANNOTATIONS. Ce depot en pose dix
			(@Retry, @CircuitBreaker dans media-service et interface-service), et
			elles sont INERTES : ni aspectjweaver ni spring-boot-starter-aop dans
			aucun POM, donc aucun aspect ne les tisse. Le retrait ne change donc
			rien au comportement.

			Ce qui marche vraiment est PROGRAMMATIQUE et n'a besoin d'aucune
			auto-configuration : le registre et l'operateur reactif de
			coupe-circuit dans gateway-service, le limiteur de debit dans
			user-service. Les artefacts correspondants sont declares ci-dessous.

			Activer les annotations reste a decider : il faudrait
			spring-boot-starter-aop et resilience4j-spring-boot4, et @Retry sur une
			authentification est nocif (il rejoue des tentatives et accelere le
			verrouillage du compte).
		-->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-ratelimiter</artifactId>
		</dependency>

		<!-- SpringDoc OpenAPI pour WebFlux -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
			<version>2.10.0</version>
		</dependency>

		<!-- Jackson datatype for Java 8 date/time -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- loki4j dependencies -->
		<dependency>
			<groupId>com.github.loki4j</groupId>
			<artifactId>loki-logback-appender</artifactId>
		</dependency>
		
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-client-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>17</source>
					<target>17</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
					<parameters>true</parameters>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
