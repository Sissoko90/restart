<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Le parent est le POM de la PLATEFORME, et non spring-boot-starter-parent.

	  Ce module declarait spring-boot-starter-parent directement : il vivait donc
	  hors de la plateforme, sans son dependencyManagement, sans ses epinglages
	  de CVE, et sans platform-commons. Il n'etait pas non plus dans la liste des
	  <modules> du reacteur — personne ne le compilait.
	-->
	<parent>
		<groupId>com.abdatytch</groupId>
		<artifactId>restart-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>com.abdatytch</groupId>
	<artifactId>notification-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Notification Service</name>
	<description>Envoi des notifications de la plateforme : courriel, SMS, push</description>

	<!--
	  CE QUI A ETE RETIRE, et pourquoi.

	  Le POM precedent etait un gabarit venu d'une autre architecture que celle
	  de ce depot. Il declarait :

	    spring-boot-starter-webmvc          -> SERVLET. Cette plateforme est
	                                           reactive ; le seul module servlet
	                                           est config-service, et c'est
	                                           delibere (spring-cloud-config-server
	                                           impose Tomcat).
	    spring-boot-starter-data-jpa        -> BLOQUANT. La politique du depot est
	                                           zero blocage sur le chemin requete,
	                                           verifiee par BlockHound.
	    mysql-connector-j                  -> La plateforme est PostgreSQL.
	    zipkin-dependencies                -> C'est une BOM, pas une bibliotheque :
	                                           la declarer en dependance n'apporte
	                                           aucune classe.
	    spring-cloud-starter-vault-config  -> Aucun autre module ne l'utilise, et
	                                           les secrets viennent de .env.
	    spring-cloud-starter-openfeign     -> Feign est bloquant. auth-service en a
	                                           garde un, isole sur boundedElastic,
	                                           et c'est une exception documentee.

	  Les quatre dependances de test nommees `spring-boot-starter-<x>-test`
	  n'existent pas sous ces noms : spring-boot-starter-test suffit.
	-->
	<dependencies>

		<!-- Noyau reactif -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<!--
		  Persistance R2DBC + Flyway, comme auth-service, user-service,
		  interface-service et media-service.

		  Flyway est synchrone et pilote une connexion JDBC au DEMARRAGE
		  seulement : il ne touche pas le chemin requete. D'ou les deux pilotes —
		  r2dbc-postgresql pour le service, postgresql (JDBC) pour les
		  migrations.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-r2dbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>r2dbc-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!--
			L'AUTOCONFIGURATION Flyway, et sans elle rien ne migre.

			Spring Boot 4 a eclate ses autoconfigurations en modules distincts :
			FlywayAutoConfiguration vit dans spring-boot-flyway, et non plus
			dans spring-boot-autoconfigure. flyway-core seul met la
			BIBLIOTHEQUE sur le classpath, et personne ne lit spring.flyway.*.

			CONSTATE SUR L'ENVIRONNEMENT DE DEVELOPPEMENT, au premier demarrage
			reel : la base de ce service contenait ZERO table, sans
			flyway_schema_history, alors que les migrations etaient dans le jar
			et que `spring.flyway.enabled: true` etait servi par config-service.
			Aucune erreur, aucun avertissement.

			auth-service portait deja cette dependance — voir son pom.xml pour
			le recit complet du diagnostic. Elle manquait a TROIS modules sur
			quatre : la correction avait ete appliquee a un seul.

			FlywayAutoconfigureePartoutTest le garde desormais.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<!--
			Firebase Admin, pour les notifications push.

			Version epinglee dans le POM racine, comme Twilio : voir son
			dependencyManagement pour le choix du SDK officiel plutot que d'un
			appel direct a l'API HTTP v1 de FCM.

			AUCUN IDENTIFIANT ICI NI DANS LE DEPOT. Le compte de service est un
			fichier JSON porteur d'une CLE PRIVEE, designe par un chemin dans la
			configuration et jamais embarque. Voir ConfigurationFirebase.
		-->
		<dependency>
			<groupId>com.google.firebase</groupId>
			<artifactId>firebase-admin</artifactId>
		</dependency>

		<!--
		  Envoi de courriel. JavaMailSender n'a PAS d'API reactive : chaque envoi
		  doit etre pousse sur boundedElastic, comme le font deja les deux
		  EmailServiceImpl existants.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!--
		  Kafka reactif. Ce service est d'abord un CONSOMMATEUR : les autres
		  publient une demande de notification, il la delivre. spring-kafka
		  accompagne reactor-kafka pour les proprietes et la serialisation.
		-->
		<dependency>
			<groupId>io.projectreactor.kafka</groupId>
			<artifactId>reactor-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!--
		  Redis reactif, pour le registre des envois SMS.

		  Le registre n'est pas un cache : il relie l'identifiant rendu par le
		  fournisseur au numero destinataire, et c'est la SEULE facon de
		  rattacher un accuse de reception a un envoi. Sans lui, un accuse
		  arrive sans savoir de quel SMS il parle.

		  Variante `-reactive` et non `spring-boot-starter-data-redis` : c'est
		  celle des autres modules reactifs du depot (security-service,
		  user-service, media-service). La variante bloquante n'est utilisee que
		  par gateway-service, et une lecture Redis bloquante sur le chemin
		  d'envoi violerait la politique « zero blocage ».
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>

		<!--
		  Fournisseur SMS Twilio.

		  La version est geree au POM racine, et PAS ici : auth-service la
		  figeait a 10.6.3 dans son propre POM, ou elle echappait a la gestion
		  centrale. Une version dans un module surcharge le dependencyManagement
		  racine et rend la propriete decorative — le depot a deja paye cette
		  erreur avec resilience4j.
		-->
		<dependency>
			<groupId>com.twilio.sdk</groupId>
			<artifactId>twilio</artifactId>
		</dependency>

		<!--
		  Le registre des disjoncteurs.

		  platform-commons apporte le MECANISME (DisjoncteurSortant) mais pas le
		  bean CircuitBreakerRegistry : celui-la vient de l'auto-configuration
		  que ce starter amene, exactement comme dans auth-service. Sans lui, le
		  bean du disjoncteur ne pourrait pas etre construit.

		  Noter que resilience4j-spring-boot3 arrive ici en 2.3.0 par ce starter,
		  transitivement, donc sans le verificateur qui refuse Spring Boot 4.
		  Voir le commentaire de `resilience4j.version` au POM racine.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
		</dependency>

		<!--
		  Le socle partage : CheminsPublics, GatewayClientIp, HMACSignatureUtil,
		  PrivateNetworks, ClesRedisSecurite. Sans lui, ce module reecrirait les
		  memes controles — et c'est precisement en les reecrivant que les autres
		  ont diverge.
		-->
		<dependency>
			<groupId>com.abdatytch</groupId>
			<artifactId>platform-commons</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>

		<!-- Securite : le service est derriere la passerelle, et verifie les jetons -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Decouverte et configuration -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-consul-discovery</artifactId>
		</dependency>

		<!-- Observabilite -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.loki4j</groupId>
			<artifactId>loki-logback-appender</artifactId>
		</dependency>

		<!-- Documentation d'API -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
		</dependency>

		<!-- Chargement de .env, comme les autres modules -->
		<dependency>
			<groupId>io.github.cdimascio</groupId>
			<artifactId>dotenv-java</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  BlockHound : la politique « zero blocage sur le chemin requete » n'est
		  pas une intention, elle est mesuree. Ce module envoie du SMTP, qui est
		  bloquant par nature — c'est donc precisement ici qu'un oubli de
		  subscribeOn(boundedElastic) coute le plus cher.
		-->
		<dependency>
			<groupId>io.projectreactor.tools</groupId>
			<artifactId>blockhound</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  Le PONT entre Micrometer Tracing et Brave.

		  spring-boot-micrometer-tracing-brave, declare juste au-dessus, apporte
		  l'auto-configuration et ne tire PAS ce pont de facon transitive.
		  Mesure du 2026-11-14 : cinq modules avaient l'auto-configuration sans
		  le pont, donc aucune implementation de Tracer, donc un %X{traceId}
		  vide malgre les deux autres conditions reunies.

		  Les trois morceaux sont necessaires, et aucun ne suffit : ce pont,
		  l'auto-configuration, et spring.reactor.context-propagation=auto dans
		  config-repo/dev/application-dev.yml.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-brave</artifactId>
		</dependency>

		<!--
		  L'AUTO-CONFIGURATION du tracage, et pas seulement sa bibliotheque.

		  Spring Boot 4 a modularise son auto-configuration : celle du tracage
		  vit dans cet artefact. Le pont micrometer-tracing-bridge-brave, quand
		  il est present, n'apporte que les classes et ne cable RIEN. Sans cet
		  artefact : aucun bean Tracer, aucun decorateur de MDC, donc un
		  %X{traceId} qui reste vide a chaque ligne.

		  IL NE SUFFIT PAS A LUI SEUL sur une pile reactive. Le MDC est lie au
		  fil, et WebFlux execute sur les boucles d'evenements de Netty : il faut
		  en plus spring.reactor.context-propagation=auto, pose dans
		  config-repo/dev/application-dev.yml.

		  Mesure du 2026-11-14, sur le service en marche :
		    auto-configuration seule          -> 0 ligne tracee
		    propriete seule                   -> 0 ligne tracee
		    les deux                          -> 255 lignes tracees
		  auth-service, qui portait l'auto-configuration sans la propriete,
		  tracait ses taches planifiees et aucune requete HTTP : huit lignes sur
		  quatre cent quatre-vingt-huit.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-brave</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
