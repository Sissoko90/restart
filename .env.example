# ==========================================
ADMIN_MAIL_ENABLED=
ADMIN_MAIL_HOST=
ADMIN_MAIL_PORT=
ADMIN_MAIL_USERNAME=
ADMIN_MAIL_PASSWORD=
ADMIN_MAIL_FROM=

# ==========================================
# CRITICAL EMAIL CREDENTIALS (SMTP) - Dernière couche de sécurité
# ==========================================
CRITICAL_MAIL_ENABLED=
CRITICAL_MAIL_HOST=
CRITICAL_MAIL_PORT=
CRITICAL_MAIL_USERNAME=
CRITICAL_MAIL_PASSWORD=
CRITICAL_MAIL_FROM=

# ==========================================
# SMS
# ==========================================
# Deux reglages :
#   SMS_ENABLED  coupe TOUT envoi (interrupteur d'exploitation)
#   SMS_PROVIDER designe le fournisseur qui sert : afriksms (defaut) ou twilio
#
# C'est SMS_PROVIDER qui desactive un fournisseur : celui qui n'est pas designe
# ne sert pas. Un SMS_PROVIDER inconnu empeche auth-service de demarrer, avec la
# liste des valeurs acceptees. C'est voulu : le fournisseur est sur le chemin de
# l'inscription, et une faute de frappe ne doit pas se traduire par des SMS qui
# cessent de partir en silence.
SMS_ENABLED=
SMS_PROVIDER=

# --- AfrikSMS (fournisseur retenu) ---
# SMS_AFRIKSMS_SENDER_ID : 11 caracteres au maximum, tronque au-dela.
SMS_AFRIKSMS_URL=
SMS_AFRIKSMS_CLIENT_ID=
SMS_AFRIKSMS_API_KEY=
SMS_AFRIKSMS_SENDER_ID=
SMS_AFRIKSMS_TIMEOUT_SECONDS=

# --- Accuses de reception AfrikSMS ---
# NOTIFY_URL doit pointer sur le GATEWAY et porter la cle en parametre :
#   https://<hote-public>/api/v1/sms/accuses/afriksms?cle=<NOTIFY_SECRET>
# NOTIFY_SECRET vide => tous les accuses sont refuses. C'est le seul moyen
# d'authentifier AfrikSMS, qui ne signe rien.
# NOTIFY_TYPE : 1 = POST, 2 = GET (les deux formes sont acceptees a la reception)
SMS_AFRIKSMS_NOTIFY_URL=
SMS_AFRIKSMS_NOTIFY_SECRET=
SMS_AFRIKSMS_NOTIFY_TYPE=
SMS_REGISTRE_DUREE_HEURES=

# --- Les deux URL qui manquaient dans ce fichier ---
#
# Elles ont un defaut dans notification-service-dev.yml, donc leur absence ne
# cassait rien — mais elles ne figuraient pas ici, et personne ne pouvait donc
# savoir qu'elles existent ni les pointer vers un bac a sable.
SMS_AFRIKSMS_CALLBACK_URL=
SMS_AFRIKSMS_BALANCE_URL=

# --- Garde-fous de depense ---
#
# SMS_PLAFOND_JOURNALIER : nombre maximal d'envois ACCEPTES par jour. Au-dela,
#   les envois sont refuses, avec une trace en ERROR et une alerte Prometheus.
#   Il existe parce que la surveillance du solde ne tourne QU'UNE FOIS PAR JOUR
#   et qu'un credit epuise ne produit aucune erreur HTTP : sans plafond, une
#   boucle fautive vide le solde entre deux releves. Defaut 500 ; 0 desactive.
#
# SMS_NUMEROS_AUTORISES : en developpement, les SEULS numeros qui recoivent
#   reellement. VIDE = aucun filtrage, donc comportement de production.
#   Renseigne, un numero absent est journalise et jete sans appel au
#   fournisseur — donc sans credit. C'est ce qu'il faut pour essayer un envoi
#   reel sans ecrire a des personnes reelles, ce que SMS_ENABLED ne permet pas
#   puisqu'il est tout ou rien. Plusieurs numeros separes par des virgules ; la
#   comparaison porte sur le numero normalise.
SMS_PLAFOND_JOURNALIER=
SMS_NUMEROS_AUTORISES=

# --- Adresse de notification-service, pour auth-service ---
#
# auth-service lui delegue l'envoi des SMS par POST /internal/sms. Vide, aucun
# SMS ne part et le demarrage le signale en ERROR — le service demarre quand
# meme, c'est la politique du projet.
#
# Le delai est PLUS LONG que celui du fournisseur (10 s) a dessein : plus court,
# le client abandonnerait la reponse alors que l'envoi est en cours.
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_TIMEOUT_SECONDS=

# --- Adresse de user-service, pour notification-service ---
#
# notification-service ne detient AUCUN contact : il demande a user-service ou
# joindre une personne, par GET /internal/users/auth/{sub}. Une adresse
# recopiee serait une seconde verite, et un message partirait a l'ancienne
# apres un changement.
#
# Vide, les canaux COURRIEL, SMS et PUSH refusent toute remise et le demarrage
# le signale en ERROR. IN_APP et WEBSOCKET continuent : ils routent sur
# l'identifiant du porteur, sans adresse.
USER_SERVICE_URL=
USER_SERVICE_TIMEOUT_SECONDS=

# --- Twilio (conserve, inactif) ---
# Pour repasser a Twilio : SMS_PROVIDER=twilio. Rien a recompiler.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=

# ==========================================
# CONSUL DISCOVERY
# ==========================================
CONSUL_HOST=
CONSUL_PORT=

# ==========================================
# VAULT (si utilisé)
# ==========================================
VAULT_ENABLED=
VAULT_TOKEN=
VAULT_HOST=
VAULT_PORT=
VAULT_SCHEME=

# ==========================================
# ADMIN PAR DÉFAUT (SEEDER)
# ==========================================
ADMIN_DEFAULT_PHONE=
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_FIRSTNAME=
ADMIN_DEFAULT_LASTNAME=

# ==========================================
# OAUTH2 - GOOGLE
# ==========================================
# Configuration Google OAuth2
# 1. Aller sur https://console.cloud.google.com/
# 2. Créer un projet ou sélectionner un projet existant
# 3. Activer "Google+ API" ou "Google Identity Services"
# 4. Créer des identifiants OAuth 2.0
# 5. Ajouter les URI de redirection autorisées
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=

# ==========================================
# OAUTH2 - FACEBOOK
# ==========================================
# Configuration Facebook OAuth2
# 1. Aller sur https://developers.facebook.com/
# 2. Créer une application
# 3. Ajouter le produit "Facebook Login"
# 4. Configurer les URI de redirection OAuth valides
# 5. Copier App ID et App Secret
OAUTH2_FACEBOOK_CLIENT_ID=
OAUTH2_FACEBOOK_CLIENT_SECRET=
OAUTH2_FACEBOOK_REDIRECT_URI=

# ==========================================
# GRAFANA ALERTING - SMTP CONFIGURATION
# ==========================================
# Configuration SMTP pour les alertes de sécurité Grafana
# Utilise le même compte Gmail que EMAIL_USERNAME ci-dessus
GF_SMTP_ENABLED=
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_FROM_NAME=
GF_SMTP_SKIP_VERIFY=
GF_SMTP_STARTTLS_POLICY=

# Alerting Configuration
GF_ALERTING_ENABLED=
GF_UNIFIED_ALERTING_ENABLED=
GF_UNIFIED_ALERTING_EXECUTE_ALERTS=
GF_UNIFIED_ALERTING_EVALUATION_TIMEOUT=
GF_UNIFIED_ALERTING_MAX_ATTEMPTS=

# Security Admin Configuration
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
GF_SECURITY_SECRET_KEY=

# ==========================================
# USER SERVICE - FILE STORAGE
# ==========================================
FILE_UPLOAD_DIR=
FILE_BASE_URL=

# ==========================================
# SECURITY CONFIGURATION - Advanced Filtering
# ==========================================
# RSA & JWKS Configuration (interface-service distribue les clés maintenant)
# JWKS_URL est défini plus haut (ligne 46) - interface-service est la source
JWKS_CACHE_TTL=
JWKS_CACHE_SIZE=
RSA_KEY_SIZE=
JWT_ALGORITHM=

# ==========================================
# RECOVERY SECRET RSA KEYS
# ==========================================
# Clés RSA pour chiffrer/déchiffrer le recovery secret (régénéré toutes les 24h)
# La clé privée est nécessaire pour déchiffrer les recovery secrets reçus par email
# ⚠️ IMPORTANT: Gardez la clé privée en sécurité!
RECOVERY_RSA_PUBLIC_KEY=
RECOVERY_RSA_PRIVATE_KEY=

# ZIP Bomb Protection (déjà défini ligne 54-58)

# IP Blacklist Configuration
IP_BLACKLIST_ENABLED=
IP_BLACKLIST_CACHE_TTL=
IP_BLACKLIST_MAX_ATTEMPTS=
IP_BLACKLIST_BLOCK_DURATION=

# Body & XSS Filtering
BODY_FILTER_ENABLED=
BODY_MAX_SIZE=
XSS_FILTER_ENABLED=
XSS_SANITIZE_HTML=
XSS_BLOCK_SCRIPTS=

# Request Filtering
REQUEST_FILTER_ENABLED=
REQUEST_MAX_HEADERS=
REQUEST_MAX_HEADER_SIZE=
REQUEST_MAX_URI_LENGTH=

# Content Security Policy
CSP_ENABLED=
CSP_REPORT_ONLY=
CSP_REPORT_URI=

# CORS Security
CORS_STRICT_MODE=
CORS_MAX_AGE=
CORS_ALLOW_CREDENTIALS=

# Rate Limiting Security
RATE_LIMIT_GLOBAL_ENABLED=
RATE_LIMIT_PER_IP_REQUESTS=
RATE_LIMIT_PER_IP_WINDOW=
RATE_LIMIT_BURST_CAPACITY=

# SSL/TLS Configuration
SSL_ENABLED=
SSL_KEY_STORE_PATH=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=
SSL_PROTOCOL=
SSL_CIPHERS=

# ==========================================================
# ALERTES CRITIQUES ET URL PUBLIQUE
# ==========================================================
# Destinataire des alertes d'attaque sur le compte administrateur.
# Était écrit en dur dans AdminController.
SECURITY_CRITICAL_ALERT_EMAIL=

# Base publique du portail, pour les liens envoyés par courriel.
# Était figée sur http://localhost:8081.
APP_PUBLIC_BASE_URL=

# ==========================================================
# SUPER ADMIN - responsable technique de la plateforme
# ==========================================================
# Cree au demarrage par SuperAdminSeeder. Seul chemin par lequel le
# role SUPER_ADMIN existe : il n'est pas attribuable par l'API.
#
# DOIT differer de ADMIN_DEFAULT_* : une compromission de l'un ne doit
# pas livrer l'autre.
#
# Si ces trois variables sont vides, aucun compte n'est cree.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# ==========================================================
# WEBAUTHN / FIDO2
# ==========================================================
# rp-id : le domaine seul. origin : schema + domaine + port.
# Doivent correspondre exactement au navigateur.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8081

# Application frontale (cible de redirection apres rappel OAuth2)
FRONTEND_BASE_URL=http://localhost:3000

# --- Consentement de notification, par canal ---
#
# Le consentement lui-meme vit dans setting-service, par utilisateur, sous les
# cles `notifications.canal.<canal>`. Ces variables ne sont QUE le defaut, pour
# la quasi-totalite des comptes qui n'a rien regle.
#
# COURRIEL accorde : c'est par lui qu'on confirme une inscription et qu'on
#   previent d'un changement de mot de passe. Le refuser par defaut rendrait la
#   plateforme inutilisable.
# SMS et PUSH refuses : un SMS se paie et arrive sur le telephone de la
#   personne. On les demande, on ne les impose pas.
#
# Modifiables a chaud par POST /actuator/refresh.
NOTIFICATION_CONSENTEMENT_COURRIEL=
NOTIFICATION_CONSENTEMENT_SMS=
NOTIFICATION_CONSENTEMENT_PUSH=

# --- Adresse de setting-service, pour notification-service ---
#
# Lu par GET /internal/settings/users/{sub}. Vide, aucun consentement n'est lu
# et les defauts ci-dessus s'appliquent — un repli acceptable, puisque le
# defaut du SMS et du push EST le refus.
SETTING_SERVICE_URL=
SETTING_SERVICE_TIMEOUT_SECONDS=

# --- Second compte SMTP, pour les notifications CRITIQUES ---
#
# Alertes de securite et codes de verification. Un compte dedie garde leur
# reputation d'expedition separee de celle du trafic ordinaire : un courriel
# marque indesirable parce qu'une campagne a sature le compte commun est un
# code que personne ne recoit.
#
# Chaque valeur RETOMBE sur celle du compte ordinaire (SMTP_*) si elle est
# vide. Un second compte ameliore la remise, il n'en est pas la condition.
NOTIFICATION_EMAIL_CRITIQUE_HOST=
NOTIFICATION_EMAIL_CRITIQUE_PORT=
NOTIFICATION_EMAIL_CRITIQUE_USERNAME=
NOTIFICATION_EMAIL_CRITIQUE_PASSWORD=

