# ============================================
# VARIABLES D'ENVIRONNEMENT - SECRETS SENSIBLES
# ============================================
# ⚠️  IMPORTANT : Ce fichier contient UNIQUEMENT les secrets sensibles
# ⚠️  Toute la configuration métier est dans config-repo/dev/
# ⚠️  Ne JAMAIS commiter ce fichier dans Git
# ============================================

# ==========================================
# SPRING PROFILES
# ==========================================
SPRING_PROFILES_ACTIVE=

# ==========================================
# JWT SECRETS
# ==========================================
# Clé secrète pour signer les JWT (HMAC-SHA256)
JWT_SECRET=

# Clé secrète pour sécuriser les endpoints admin
ADMIN_SECRET_KEY=

# Clé secrète pour l'accès maintenance (dernière couche de sécurité)
MAINTENANCE_SECRET_KEY=

# ==========================================
# MAINTENANCE USER (SEEDER)
# ==========================================
MAINTENANCE_PHONE=
MAINTENANCE_PASSWORD=
# Etait ecrite en dur dans MaintenanceSeeder. Sans les TROIS valeurs de cette
# section, le compte de maintenance n'est pas cree et le service demarre quand
# meme.
MAINTENANCE_EMAIL=

# ==========================================
# CLES DE SIGNATURE JWT (interface-service)
# ==========================================
# La cle privee signe TOUS les jetons de la plateforme.
#
# Elle etait auparavant dans src/main/resources/keys, donc EMPAQUETEE
# DANS LE JAR livre : quiconque disposait de l'artefact pouvait
# l'extraire et forger n'importe quel jeton, pour n'importe quel role.
# Le chargement depuis le classpath est desormais refuse.
#
# Generer une paire :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -out secrets/dev_private.pem
#   openssl rsa -pubout -in secrets/dev_private.pem \
#     -out secrets/dev_public.pem
#
# Puis extraire le Base64 (sans les en-tetes -----BEGIN/END-----).

# a) Contenu en variable. RECOMMANDE : compatible avec les secrets
#    Docker et Kubernetes, et insensible au repertoire de travail.
JWT_DEV_PRIVATE_KEY=
JWT_DEV_PUBLIC_KEY=

# b) Chemins vers des fichiers HORS du classpath. Alternative si les
#    cles sont montees depuis un volume.
JWT_DEV_PRIVATE_KEY_PATH=
JWT_DEV_PUBLIC_KEY_PATH=

# Poste de developpement UNIQUEMENT : genere une paire ephemere quand
# rien n'est configure. Elle change a chaque redemarrage (tous les
# jetons emis deviennent invalides) et differe d'une instance a l'autre
# (les jetons sont refuses au hasard derriere un repartiteur).
JWT_DEV_KEY_ALLOW_EPHEMERAL=false

# Durées d'expiration JWT (en millisecondes)
JWT_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# ==========================================
# RSA KEY ROTATION CONFIGURATION
# ==========================================
# Activer/désactiver la rotation automatique des clés RSA
JWT_KEY_ROTATION_ENABLED=

# Intervalle de rotation des clés RSA (en jours)
# Valeur recommandée: 90 jours en production
JWT_KEY_ROTATION_INTERVAL_DAYS=

# Période de grâce pour les anciennes clés (en jours)
# Les anciennes clés restent valides pendant cette période après rotation
JWT_KEY_ROTATION_GRACE_PERIOD_DAYS=

# ==========================================
# JWKS CONFIGURATION
# ==========================================
# URL JWKS pour récupérer les clés publiques des développeurs depuis interface-service
JWKS_URL=

# Intervalle de rafraîchissement des clés JWKS (en secondes)
# Les services (gateway, user, media, quotas, setting) récupèrent les clés publiques depuis interface-service
# Valeur recommandée: 300 (5 min) en dev, 3600 (1h) en production
JWKS_REFRESH_INTERVAL_SECONDS=

# ==========================================
# ZIP BOMB PROTECTION
# ==========================================
# Protection contre les attaques Zip Bomb (fichiers compressés malveillants)
ZIPBOMB_ENABLED=
ZIPBOMB_MAX_COMPRESSION_RATIO=
ZIPBOMB_MAX_UNCOMPRESSED_SIZE_MB=
ZIPBOMB_MAX_ENTRIES=
ZIPBOMB_MAX_NESTED_DEPTH=

# ==========================================
# GATEWAY SECURITY - 2 CLÉS DISTINCTES
# ==========================================
# 1️⃣ Clé secrète pour authentifier Gateway → Microservices (Backend)
#    Utilisée par: GatewayRoutesConfig (ajoute header X-Gateway-Request)
#                  auth-service/GatewayAccessFilter (vérifie header)
#                  user-service/GatewayAccessFilter (vérifie header)
# IMPORTANT: Cette clé doit rester SECRÈTE côté serveur uniquement
GATEWAY_SECRET_KEY=

# ==========================================
# MEDIA SERVICE SECRETS
# ==========================================
ENCRYPTION_MASTER_KEY=

# Nombre maximum de tentatives d'upload par document (avant blocage)
MEDIA_UPLOAD_MAX_ATTEMPTS=

# 2️⃣ Clé API pour les clients externes (Frontend, Mobile Apps)
#    Utilisée pour authentifier les requêtes publiques vers le Gateway
GATEWAY_API_KEY=

# ==========================================
# DOCUMENTATION AGREGEE (passerelle)
# ==========================================
# Identifiants de lecture de l'interface Swagger agregee, servie par la
# passerelle sur /swagger-ui.html.
#
# POURQUOI une authentification dediee : un navigateur qui charge Swagger ne
# porte aucun jeton JWT, donc le modele de roles de la plateforme ne peut pas
# garder cette page sans une session navigateur qui n'existe pas ici.
#
# DEDIES : ils ne correspondent a aucun compte de la plateforme. Les
# compromettre ne donne acces a aucune donnee, seulement a la description de
# l'API — qui couvre toute la surface, chemins d'administration compris.
#
# ABSENTS : la documentation rend 404 et le service demarre normalement. Jamais
# de refus de demarrage pour une variable absente, jamais non plus d'ouverture
# par defaut.
#
# La documentation des services n'est joignable QUE par la passerelle : chacun
# n'exempte la sienne que du jeton, jamais de la signature HMAC.
GATEWAY_DOCS_USER=
GATEWAY_DOCS_PASSWORD=

# ==========================================
# INTERNAL SERVICE SECRET
# ==========================================
# Secret pour la communication inter-services (auth-service → interface-service)
# Utilisé pour signer les JWT des utilisateurs finaux
INTERNAL_SERVICE_SECRET=

