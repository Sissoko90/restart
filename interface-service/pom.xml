<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>com.abdatytch</groupId>
		<artifactId>restart-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	
	<groupId>com.abdatytch</groupId>
	<artifactId>interface-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Interface Service</name>
	<description>Service d'interface pour les développeurs Restart</description>
	
	<properties>
		<!-- Paramètres Flyway (surchargeables en ligne de commande) -->
		<flyway.url>jdbc:postgresql://localhost:5432/interface_db</flyway.url>
		<flyway.user>postgres</flyway.user>
		<flyway.password></flyway.password>
	</properties>
	
	<dependencies>
		<!-- Détection des appels bloquants sur threads non bloquants (tests) -->
		<dependency>
			<groupId>io.projectreactor.tools</groupId>
			<artifactId>blockhound</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Socle sécurité partagé : JWKS, HMAC Gateway, comparaison de secrets -->
		<dependency>
			<groupId>com.abdatytch</groupId>
			<artifactId>platform-commons</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Dotenv pour charger les variables d'environnement -->
		<dependency>
			<groupId>io.github.cdimascio</groupId>
			<artifactId>dotenv-java</artifactId>
		</dependency>
		
		<!-- Spring Boot Starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-r2dbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		
		<!-- R2DBC PostgreSQL -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>r2dbc-postgresql</artifactId>
		</dependency>
		
		<!-- JDBC PostgreSQL pour Flyway -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!--
			Flyway et son AUTOCONFIGURATION.

			Le pilote JDBC ci-dessus etait declare « pour Flyway », et Flyway
			n'etait pas la. Ce module embarque pourtant neuf fichiers de migration
			dans src/main/resources/db/migration : aucun n'a jamais pu s'appliquer
			depuis ce jar.

			CONSTAT, mesure le 2026-11-10 sur l'environnement de developpement :
			interface_db est restee a la version 8, datee du 2026-04-17.
			Flyway y a donc tourne une fois, sous un arrangement anterieur,
			puis plus jamais. V9 attend depuis : la colonne
			users.refresh_token, celle qui portait les jetons EN CLAIR, est
			toujours dans le schema alors que le code ne lit plus que
			refresh_token_hash. Elle ne contient aucune valeur — verifie —
			donc rien n'a fui ; c'est une structure morte, pas une fuite.

			LES DEUX ARTEFACTS SONT NECESSAIRES, et c'est le piege. Spring Boot 4 a
			eclate ses autoconfigurations en modules distincts :
			FlywayAutoConfiguration vit desormais dans spring-boot-flyway.
			flyway-core seul met la BIBLIOTHEQUE sur le chemin de classe, et
			personne ne lit spring.flyway.* — sans erreur, sans avertissement, sans
			ligne de journal.

			GARDE-FOU. FlywayAutoconfigureePartoutTest, dans platform-commons,
			refuse desormais un module qui porte des migrations sans ces trois
			declarations. Sa version precedente ne voyait PAS ce module : elle
			partait de flyway-core pour exiger spring-boot-flyway, et ici ni l'un ni
			l'autre n'etait declare. Une implication dont la premisse est fausse est
			vraie, donc verte.
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		
		<!-- JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		
		<!--
			LE REGISTRE DES DISJONCTEURS, requis depuis la migration des courriels d'OTP.

			platform-commons apporte le MECANISME — DisjoncteurSortant et
			IDisjoncteurSortant — mais pas le bean CircuitBreakerRegistry : celui-la
			vient de l'auto-configuration que ce starter amene, exactement comme dans
			auth-service et notification-service.

			Ce module en a besoin depuis que ses deux courriels de code a usage
			unique passent par ClientMessagerieNotification, lui-meme protege par un
			disjoncteur. Sans ce starter, le CONTEXTE NE DEMARRE PAS :
			« No qualifying bean of type CircuitBreakerRegistry ». Mesure faite par
			le test de contexte au premier chargement apres la migration — aucun
			test unitaire ne pouvait le voir.

			Ce starter amene resilience4j-spring-boot3 en 2.3.0, transitivement,
			donc SANS le verificateur de 2.4.0 qui refuse Spring Boot 4. C'est la
			meme voie que les deux autres modules, et la raison pour laquelle le
			retrait documente ci-dessous reste vrai : ce qui a ete retire est la
			DECLARATION DIRECTE de resilience4j-spring-boot3, pas ce starter.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
		</dependency>

		<!-- Resilience4j -->
		<!--
			resilience4j-spring-boot3 a ete RETIRE, et ce n'est pas un choix de
			confort : en 2.4.0 il REFUSE de demarrer sur Spring Boot 4.

			  Module 'io.github.resilience4j:resilience4j-spring-boot3' is only
			  compatible with Spring Boot 3.x

			Mesure : le test de contexte de gateway-service est le seul a
			l'attraper. En 2.1.0 / 2.2.0 ce controle n'existait pas, donc
			l'artefact etait la, silencieux.

			Et il ne servait QU'AUX ANNOTATIONS. Ce depot en pose dix
			(@Retry, @CircuitBreaker dans media-service et interface-service), et
			elles sont INERTES : ni aspectjweaver ni spring-boot-starter-aop dans
			aucun POM, donc aucun aspect ne les tisse. Le retrait ne change donc
			rien au comportement.

			Ce qui marche vraiment est PROGRAMMATIQUE et n'a besoin d'aucune
			auto-configuration : le registre et l'operateur reactif de
			coupe-circuit dans gateway-service, le limiteur de debit dans
			user-service. Les artefacts correspondants sont declares ci-dessous.

			Activer les annotations reste a decider : il faudrait
			spring-boot-starter-aop et resilience4j-spring-boot4, et @Retry sur une
			authentification est nocif (il rejoue des tentatives et accelere le
			verrouillage du compte).
		-->
		<!--
			resilience4j-annotations, et RIEN DE PLUS.

			Ce module n'utilise de resilience4j que les ANNOTATIONS (@Retry,
			@CircuitBreaker) : aucune classe d'execution, aucun registre. Mesure
			faite en cherchant la classe dans les jars du depot local :
			io.github.resilience4j.circuitbreaker.annotation.CircuitBreaker vit
			dans resilience4j-annotations, pas dans resilience4j-circuitbreaker.

			Declarer les artefacts d'execution ici aurait embarque du code que
			personne n'appelle. Les annotations restent inertes — voir le
			commentaire ci-dessus.
		-->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-annotations</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-reactor</artifactId>
		</dependency>
		
		<!-- Spring Cloud Config -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		
		<!-- Spring Cloud Consul -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-consul-discovery</artifactId>
		</dependency>
		
		<!-- Spring Kafka -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- Consommation réactive des demandes d'effacement. spring-kafka est
		     déjà présent pour la publication, mais son @KafkaListener est
		     bloquant : sur une application WebFlux il immobiliserait un thread
		     de l'EventLoop (voir docs/NON-BLOCKING.md). -->
		<dependency>
			<groupId>io.projectreactor.kafka</groupId>
			<artifactId>reactor-kafka</artifactId>
		</dependency>
		
		<!-- Spring Security OAuth2 Resource Server -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		
		<!-- Micrometer pour métriques Grafana -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		
		<!--
			spring-boot-starter-mail A ETE RETIRE.

			Ce service n'envoie plus aucun courriel : ses quatre methodes d'envoi
			deleguent a notification-service par le client partage de
			platform-commons. AdminEmailConfig et ses trois JavaMailSender ont ete
			supprimes, et avec eux la seule chose qui faisait de ce module un
			expediteur.

			Le meme retrait a ete fait dans auth-service, et pour la meme raison :
			un seul service sait parler SMTP, donc un seul endroit ou une
			configuration d'expedition peut etre fausse.
		-->
		
		<!-- Auth0 JWT Library -->
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.4.0</version>
		</dependency>

		<!-- MaxMind GeoIP2 pour la géolocalisation -->
		<dependency>
			<groupId>com.maxmind.geoip2</groupId>
			<artifactId>geoip2</artifactId>
			<version>4.2.0</version>
		</dependency>

		<!-- Lombok supprimé - utilisation de getters/setters classiques -->
		
		<!-- OpenAPI/Swagger -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
			<version>2.7.0</version>
		</dependency>
		
		<!-- Dev Tools -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		
		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	
<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<configuration>
					<!-- Aucun secret en dur : surcharger via -D ou variables d'environnement.
					     Ex: ./mvnw flyway:migrate -Dflyway.password=$DB_PASSWORD -->
					<url>${flyway.url}</url>
					<user>${flyway.user}</user>
					<password>${flyway.password}</password>
					<locations>classpath:db/migration</locations>
					<baselineOnMigrate>true</baselineOnMigrate>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
