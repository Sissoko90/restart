	<parent>
		<groupId>com.abdatytch</groupId>
		<artifactId>restart-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<groupId>com.abdatytch</groupId>
	<artifactId>quotas-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Quotas Service</name>
	<description>Service de gestion des quotas par projet et par tier</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<dependencies>
		<!-- Détection des appels bloquants sur threads non bloquants (tests) -->
