<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.abdatytch</groupId>
		<artifactId>restart-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<groupId>com.abdatytch</groupId>
	<artifactId>setting-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Setting Service</name>
	<description>Service de gestion des paramètres système et utilisateur</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<dependencies>
		<!-- Détection des appels bloquants sur threads non bloquants (tests) -->
		<dependency>
			<groupId>io.projectreactor.tools</groupId>
			<artifactId>blockhound</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- JWT : validation des tokens émis par interface-service -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
		</dependency>

		<!-- Flyway : schéma versionné (driver JDBC requis, Flyway n'a pas d'API réactive) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!--
			L'AUTOCONFIGURATION Flyway, et sans elle rien ne migre.

			Spring Boot 4 a eclate ses autoconfigurations en modules distincts :
			FlywayAutoConfiguration vit dans spring-boot-flyway, et non plus
			dans spring-boot-autoconfigure. flyway-core seul met la
			BIBLIOTHEQUE sur le classpath, et personne ne lit spring.flyway.*.

			CONSTATE SUR L'ENVIRONNEMENT DE DEVELOPPEMENT, au premier demarrage
			reel : la base de ce service contenait ZERO table, sans
			flyway_schema_history, alors que les migrations etaient dans le jar
			et que `spring.flyway.enabled: true` etait servi par config-service.
			Aucune erreur, aucun avertissement.

			auth-service portait deja cette dependance — voir son pom.xml pour
			le recit complet du diagnostic. Elle manquait a TROIS modules sur
			quatre : la correction avait ete appliquee a un seul.

			FlywayAutoconfigureePartoutTest le garde desormais.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<!-- OpenAPI/Swagger -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
		</dependency>

		<!-- Socle sécurité partagé : JWKS, HMAC Gateway, comparaison de secrets -->
		<dependency>
			<groupId>com.abdatytch</groupId>
			<artifactId>platform-commons</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-r2dbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>r2dbc-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-consul-discovery</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Effacement RGPD : setting-service conserve des valeurs libres par
		     utilisateur (docs/COMPLIANCE.md §1). Il doit donc consommer les
		     demandes d'effacement et accuser réception, comme les autres. -->
		<dependency>
			<groupId>io.projectreactor.kafka</groupId>
			<artifactId>reactor-kafka</artifactId>
		</dependency>

		<!--
		  Expedition des journaux vers Loki.

		  AUCUNE version ici : elle est geree par le POM racine. Une version
		  posee dans un module surcharge silencieusement celle du parent, et deux
		  modules finissent par expedier avec des appenders differents.

		  Ajoutee le 2026-11-14 : ce module avait un logback sans Loki, ou pas de
		  logback du tout. La dependance et le fichier vont ENSEMBLE — la
		  dependance seule est du poids mort, le fichier seul fait echouer le
		  demarrage sur une classe d'appender introuvable.
		-->
		<dependency>
			<groupId>com.github.loki4j</groupId>
			<artifactId>loki-logback-appender</artifactId>
		</dependency>

		<!--
		  Le PONT entre Micrometer Tracing et Brave.

		  spring-boot-micrometer-tracing-brave, declare juste au-dessus, apporte
		  l'auto-configuration et ne tire PAS ce pont de facon transitive.
		  Mesure du 2026-11-14 : cinq modules avaient l'auto-configuration sans
		  le pont, donc aucune implementation de Tracer, donc un %X{traceId}
		  vide malgre les deux autres conditions reunies.

		  Les trois morceaux sont necessaires, et aucun ne suffit : ce pont,
		  l'auto-configuration, et spring.reactor.context-propagation=auto dans
		  config-repo/dev/application-dev.yml.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-brave</artifactId>
		</dependency>

		<!--
		  L'AUTO-CONFIGURATION du tracage, et pas seulement sa bibliotheque.

		  Spring Boot 4 a modularise son auto-configuration : celle du tracage
		  vit dans cet artefact. Le pont micrometer-tracing-bridge-brave, quand
		  il est present, n'apporte que les classes et ne cable RIEN. Sans cet
		  artefact : aucun bean Tracer, aucun decorateur de MDC, donc un
		  %X{traceId} qui reste vide a chaque ligne.

		  IL NE SUFFIT PAS A LUI SEUL sur une pile reactive. Le MDC est lie au
		  fil, et WebFlux execute sur les boucles d'evenements de Netty : il faut
		  en plus spring.reactor.context-propagation=auto, pose dans
		  config-repo/dev/application-dev.yml.

		  Mesure du 2026-11-14, sur le service en marche :
		    auto-configuration seule          -> 0 ligne tracee
		    propriete seule                   -> 0 ligne tracee
		    les deux                          -> 255 lignes tracees
		  auth-service, qui portait l'auto-configuration sans la propriete,
		  tracait ses taches planifiees et aucune requete HTTP : huit lignes sur
		  quatre cent quatre-vingt-huit.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-brave</artifactId>
		</dependency>

	</dependencies>
<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
