<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name"/>
    <springProperty scope="context" name="lokiUrl" source="loki.url"
                    defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <!--
        CE FICHIER MANQUAIT, ET SON ABSENCE NE SE VOYAIT PAS.

        Sans lui, le module journalise sur la console avec le format par defaut
        de Spring Boot : lisible, mais SANS traceId ni spanId, et sans jamais
        rien expedier a Loki. Un service dont les journaux n'arrivent pas dans
        l'agregateur est invisible au moment ou l'on en a besoin — et rien ne
        le signale, puisqu'il journalise tres bien localement.

        Mesure du 2026-11-13 : six des onze modules compiles etaient dans ce
        cas.
    -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
                traceId et spanId dans le motif.

                Sans eux, une requete qui traverse la passerelle, market,
                user-service et notification-service laisse quatre journaux que
                rien ne relie. C'est precisement quand plusieurs services sont
                en cause que l'on cherche, et c'est alors qu'on ne peut plus.
            -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-}, spanId=%X{spanId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/market-service.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/market-service.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-}, spanId=%X{spanId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="com.abdatytch" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="DEBUG"/>
    <!--
        AUCUN logger Hibernate ici.

        Le modele copie en portait quatre, dont org.hibernate.SQL et le
        BasicBinder en TRACE. Ce module est en R2DBC : Hibernate n'y est pas, et
        ces lignes ne font rien. Une configuration qui nomme un composant absent
        donne a croire qu'un reglage s'applique.

        L'equivalent R2DBC se regle par org.springframework.r2dbc, laisse a INFO
        : le TRACE y imprime les VALEURS liees, donc des adresses et des numeros
        de RCCM dans les journaux.
    -->

    <!--
        Expedition vers Loki : seulement la ou Loki existe.

        Liste blanche de profils, et non « tous sauf dev » : les tests
        s'executent sans profil actif, donc une exclusion de dev les laisserait
        expedier dans le vide. Loki n'etant pas demarre en developpement, chaque
        lot echouerait et loki4j deverserait une pile complete par tentative —
        un demarrage normal ressemblerait a une panne.

        L'appender est defini DANS le bloc de profil, et pas seulement sa
        reference : loki4j demarre son fil d'expedition des sa definition.
    -->
    <springProfile name="prod | staging | observability">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
            </http>
            <encoder class="com.github.loki4j.logback.JsonEncoder">
                <label>
                    <pattern>service_name=${appName},app=${appName},host=${HOSTNAME},level=%level</pattern>
                </label>
            </encoder>
        </appender>

        <root>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
